# Development Supabase project — placeholders only.
#
# Copy to .env.development.local and fill in from the development project's
# API settings. That file is git-ignored and must never contain the
# production-or-unknown project pamhlgvwomyilsdtscid.
#
#   cp .env.development.local.example .env.development.local
#   node scripts/db-guard.mjs        # must print "Safe to proceed"

# Required. The guard refuses to run without this, and refuses any value
# other than "development". An absent marker is treated as production.
NEXT_PUBLIC_APP_ENV=development

# From: Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_DEV_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_DEV_ANON_KEY

# Server-side only. Never exposed to the browser, never committed.
SUPABASE_SERVICE_ROLE_KEY=YOUR_DEV_SERVICE_ROLE_KEY

# Needed for Vision analysis during the acceptance test. A development key is
# fine; the test can also run against the fallback path without one.
OPENAI_API_KEY=YOUR_OPENAI_KEY

# Not read from this file — export it in the shell when applying migrations:
#   Project Settings → Database → Connection string → URI
# DEV_DATABASE_URL=postgresql://postgres:PASSWORD@db.YOUR_DEV_PROJECT_REF.supabase.co:5432/postgres
